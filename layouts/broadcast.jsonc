{
  //sets the layout for the broadcast view
  "tracker_broadcast": {
    "type": "array",
    "orientation": "vertical",
    "content": [
      {
        "type": "itemgrid",
        "h_alignment": "stretch",
        "item_size": 40,
        "item_margin": "2,2",
        "rows": [
          [ "pcharge", "wide", "plasma", "wave", "grapple" ],
          [ "super", "ice", "smissile", "spider", "speed" ],
          [ "morph", "pbomb", "powerbomb", "pjump", "screw" ],
          [ "pulse", "cloak", "flash", "psuit" ],
          [ "quietrobe", "xpar", "dna" ]
        ]
      }
    ]
  }
}
